# Canonical URL used for Open Graph and canonical links (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://palimpsest.example

# Mailing list. Leave NEXT_PUBLIC_NEWSLETTER_ACTION empty to show the honest
# "not yet connected" state. When set, the invitation form POSTs straight to
# the provider; no address touches this site's code.
#   Buttondown:  https://buttondown.com/api/emails/embed-subscribe/<username>   (field: email)
#   Mailchimp:   the "action" URL from an embedded form                         (field: EMAIL)
NEXT_PUBLIC_NEWSLETTER_ACTION=
NEXT_PUBLIC_NEWSLETTER_PROVIDER=
NEXT_PUBLIC_NEWSLETTER_EMAIL_FIELD=email

# Optional contact address shown while the list is unconnected.
NEXT_PUBLIC_CONTACT_EMAIL=
